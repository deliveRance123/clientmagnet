# Application Environment (development, staging, production, test)
ENVIRONMENT=development

# CORS Configuration (comma-separated list or JSON array of origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Asynchronous Connection URL (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://postgres:localpassword@localhost:5432/client_magnet

# Fernet AES-256 encryption key for OAuth credentials stored in social/email accounts
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit a real production key here.
ENCRYPTION_KEY=y5lX0NnN2n_D9D0R_iS7xR7P3q1u3U9z8D_H_8q9J4k=

# JWT Authentication
JWT_SECRET_KEY=dev-secret-jwt-key-client-magnet-must-change-in-prod-xyz9876543210
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=cm_refresh_token

# Login Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Gemini API Integration & AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3
AI_RATE_LIMIT_PER_MINUTE=30
USE_MOCK_AI=true

# ---------------------------------------------------------------------------
# Official Social Media Platform OAuth 2.0 Credentials
# ---------------------------------------------------------------------------
# Meta / Facebook & Instagram (Developers: https://developers.facebook.com)
META_CLIENT_ID=
META_CLIENT_SECRET=

# X / Twitter Developer Portal (https://developer.x.com)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn Developer Portal (https://www.linkedin.com/developers)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok for Developers (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OAuth Callback Redirection URLs
SOCIAL_OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/social/callback
FRONTEND_SOCIAL_REDIRECT_URL=http://localhost:3000/settings/social

# Set to false in production when connecting live accounts with real client secrets
USE_MOCK_SOCIAL_OAUTH=true

# ---------------------------------------------------------------------------
# Google / Gmail OAuth 2.0 Credentials (https://console.cloud.google.com)
# ---------------------------------------------------------------------------
# Authorized redirect URI: http://localhost:8000/api/v1/email/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email/callback
FRONTEND_EMAIL_REDIRECT_URL=http://localhost:3000/email

# Set to false in production when connecting real Gmail accounts with live Google Cloud credentials
USE_MOCK_EMAIL=true

# ---------------------------------------------------------------------------
# Meta WhatsApp Business Cloud API (https://developers.facebook.com)
# ---------------------------------------------------------------------------
# Authorized Webhook Callback: http://localhost:8000/api/v1/whatsapp/webhook
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=client_magnet_whatsapp_verify_token
WHATSAPP_APP_SECRET=

# Set to false in production when connecting real WhatsApp Business phone numbers
USE_MOCK_WHATSAPP=true
